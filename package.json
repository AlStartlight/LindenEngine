{
  "name": "linden-engine",
  "version": "0.1.0",
  "description": "Modern Desktop Game Engine built with ElectronJS, TypeScript, and WebGPU",
  "main": "dist-electron/main.cjs",
  "homepage": "./",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron": "electron .",
    "electron-dev": "npm run build:electron && concurrently \"npm run dev\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.electron.json && npm run rename:electron",
    "rename:electron": "cd dist-electron && for f in *.js; do mv \"$f\" \"${f%.js}.cjs\"; done",
    "build:all": "npm run build && npm run build:electron && npm run electron-builder",
    "electron-builder": "electron-builder",
    "preview": "vite preview",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@babylonjs/core": "^6.30.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.158.0",
    "zod": "^3.22.4",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/three": "^0.158.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@webgpu/types": "^0.1.69",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "postcss": "^8.4.32",
    "sass": "^1.69.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "wait-on": "^7.1.0"
  },
  "build": {
    "appId": "com.lindenengine.editor",
    "productName": "Linden Engine",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "public"
    },
    "win": {
      "target": [
        "nsis",
        "msi"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
