{
  "name": "linden-engine",
  "version": "0.1.3",
  "description": "Modern Desktop Game Engine built with ElectronJS, TypeScript, and WebGPU",
  "main": "dist-electron/main.cjs",
  "homepage": "./",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron": "electron .",
    "electron:watch": "nodemon --watch electron --watch shared --watch engine/godot --watch engine/transmuter --ext ts --delay 300ms --exec \"npm run build:electron && electron .\"",
    "electron-dev": "concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:5173 && npm run electron:watch\"",
    "build": "tsc && vite build && npm run build:player",
    "build:player": "node scripts/build-player.mjs",
    "build:electron": "tsc -p tsconfig.electron.json --noEmit && node scripts/build-electron.mjs",
    "build:all": "npm run build && npm run build:electron && npm run electron-builder",
    "electron-builder": "electron-builder",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:cases": "playwright test -c docs/test-case/playwright.config.ts",
    "test:cases:1m": "bash docs/test-case-1m/tools/run-all.sh",
    "test:e2e:play": "npm run build:electron && node tests/e2e/playViewport.e2e.mjs",
    "test:e2e:move": "npm run build:electron && node tests/e2e/movement.e2e.mjs",
    "test:e2e:touch": "npm run build:electron && node tests/e2e/touchButtons.e2e.mjs",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@babylonjs/core": "^6.30.0",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@opencode/client": "^2.1.4",
    "@types/ws": "^8.18.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rolldown": "^1.2.15",
    "three": "^0.186.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@webgpu/types": "^0.1.69",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "nodemon": "^3.1.14",
    "postcss": "^8.4.32",
    "sass": "^1.69.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^7.1.0"
  },
  "build": {
    "appId": "com.lindenengine.editor",
    "productName": "Linden Engine",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "msi"
      ],
      "icon": "resources/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Linden Engine Contributors",
      "icon": "resources/icon.png"
    },
    "afterSign": "scripts/adhoc-sign.cjs",
    "extraResources": [
      {
        "from": "resources/bridge",
        "to": "resources/bridge",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "dist-player",
        "to": "player-runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/templates",
        "to": "templates",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "electron/agent/prompts",
        "to": "agent/prompts",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/@rolldown/binding-*/**"
    ]
  },
  "author": "Linden Engine Contributors"
}
