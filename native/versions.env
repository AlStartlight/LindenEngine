# Pinned toolchain and sources for `npm run build:native` (native/build.sh). Changing a version means
# updating its SHA-256 too; the build refuses archives that do not match.
EMSDK_VERSION=6.0.13
CMAKE_VERSION=4.4.4
NINJA_VERSION=1.13.2
# emsdk needs Python >= 3.10; uv fetches a standalone CPython into native/.python
UV_VERSION=0.13.6
PYTHON_VERSION=3.12

OPENSUBDIV_TAG=v3_6_1
OPENSUBDIV_URL=https://github.com/PixarAnimationStudios/OpenSubdiv/archive/refs/tags/v3_6_1.tar.gz
OPENSUBDIV_SHA256=e9d99a480d80e999667643747c76eb0138d36c418fc154fd71b4bd65be103d52

GEOGRAM_VERSION=1.10.1
GEOGRAM_URL=https://github.com/BrunoLevy/geogram/releases/download/v1.10.1/geogram_1.10.1.tar.gz
GEOGRAM_SHA256=30033340a0dfd86f9e15a8ffdd7c1e6d49b967d3f26fb96cf3dfd1a502d8eba2

# Fixed build timestamp (Geogram embeds its configure time otherwise): its 1.10.1 release date
SOURCE_DATE_EPOCH=1788220800
